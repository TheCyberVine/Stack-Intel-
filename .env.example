# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Stack Intel Configuration
# VITE_DATA_MODE: "demo" (uses isolated fixtures) or "live" (connects to FastAPI backend)
VITE_DATA_MODE="demo"

# VITE_API_BASE_URL: Base URL for backend API when in live mode (e.g. http://localhost:8000)
VITE_API_BASE_URL="http://localhost:8000"
